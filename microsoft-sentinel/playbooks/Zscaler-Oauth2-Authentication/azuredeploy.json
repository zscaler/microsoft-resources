{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "metadata": {
        "title": "Zscaler OAuth2 Authentication",
        "description": "This playbook obtains OAuth2 access tokens for Zscaler integrations. It supports both OneAPI and Legacy authentication. Fill in ONE set of parameters — OneAPI OR Legacy — and leave the other set empty.",
        "mainSteps": [
            "1. Determines auth mode: OneAPI (vanity domain provided) or Legacy (token URL provided)",
            "2. Requests an access token from the appropriate OAuth2 token endpoint",
            "3. Returns the token response with base_url to the caller"
        ],
        "prerequisites": [
            "1. Zscaler subscription with API access enabled",
            "2. For OneAPI: Client ID, Client Secret, and Vanity Domain from the Zscaler ZIdentity admin portal",
            "3. For Legacy: Client ID, Client Secret, Token URL, OAuth Scope, and Base URL from your Entra ID app registration and Zscaler admin"
        ],
        "lastUpdateTime": "2025-09-02T00:00:00.000Z",
        "entities": [],
        "tags": [
            "Utilities"
        ],
        "support": {
            "tier": "Partner"
        },
        "author": {
            "name": "Zscaler"
        },
        "source": {
            "type": "solution",
            "name": "Zscaler OneAPI"
        },
        "postDeployment": [
            "**a. Validate**",
            "Trigger the playbook and confirm a token is returned."
        ],
        "releaseNotes": [
            {
                "version": "3.1.0",
                "title": "Zscaler OAuth2 Authentication - Separated OneAPI + Legacy Parameters",
                "notes": [
                    "Separated OneAPI and Legacy parameters for clarity",
                    "Each mode has its own Client ID, Client Secret, and mode-specific fields",
                    "Fill in ONE set of parameters only — the other set should be left empty"
                ]
            }
        ]
    },
    "parameters": {
        "PlaybookName": {
            "defaultValue": "Zscaler-Oauth2-Authentication",
            "type": "string",
            "minLength": 1,
            "metadata": {
                "description": "Name of the Logic App/Playbook"
            }
        },
        "OneAPI_VanityDomain": {
            "defaultValue": "",
            "type": "string",
            "metadata": {
                "description": "[OneAPI] ZIdentity vanity domain prefix — found in your admin URL: https://<prefix>-admin.zslogin.net (e.g., z-41181109). Leave empty if using Legacy mode."
            }
        },
        "OneAPI_ClientId": {
            "defaultValue": "",
            "type": "string",
            "metadata": {
                "description": "[OneAPI] Zscaler OneAPI Client ID from the ZIdentity admin portal. Leave empty if using Legacy mode."
            }
        },
        "OneAPI_ClientSecret": {
            "defaultValue": "",
            "type": "securestring",
            "metadata": {
                "description": "[OneAPI] Zscaler OneAPI Client Secret from the ZIdentity admin portal. Leave empty if using Legacy mode."
            }
        },
        "Legacy_ClientId": {
            "defaultValue": "",
            "type": "string",
            "metadata": {
                "description": "[Legacy] Entra ID Application (Client) ID for the ZIA API Playbooks app registration. Leave empty if using OneAPI mode."
            }
        },
        "Legacy_ClientSecret": {
            "defaultValue": "",
            "type": "securestring",
            "metadata": {
                "description": "[Legacy] Entra ID Client Secret for the ZIA API Playbooks app registration. Leave empty if using OneAPI mode."
            }
        },
        "Legacy_TokenUrl": {
            "defaultValue": "",
            "type": "string",
            "metadata": {
                "description": "[Legacy] Entra ID OAuth2 token endpoint URL (e.g., https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/token). Leave empty if using OneAPI mode."
            }
        },
        "Legacy_OAuthScope": {
            "defaultValue": "",
            "type": "string",
            "metadata": {
                "description": "[Legacy] OAuth2 scope — Application ID URI from your ZIA API Web Service app registration appended with /.default (e.g., api://c0636925-82fa-49e1-be49-72afb0a9fd59/.default). Leave empty if using OneAPI mode."
            }
        },
        "Legacy_BaseUrl": {
            "defaultValue": "zsapi.zscaler.net/api/v1",
            "type": "string",
            "allowedValues": [
                "zsapi.zscaler.net/api/v1",
                "zsapi.zscalertwo.net/api/v1",
                "zsapi.zscalerthree.net/api/v1",
                "zsapi.zscloud.net/api/v1",
                "zsapi.zscalerbeta.net/api/v1",
                "zsapi.zscalergov.net/api/v1"
            ],
            "metadata": {
                "description": "[Legacy] Select your Zscaler cloud. Leave as default if using OneAPI mode."
            }
        }
    },
    "variables": {
        "isOneAPI": "[not(empty(parameters('OneAPI_VanityDomain')))]",
        "constructedTokenUrl": "[concat('https://', parameters('OneAPI_VanityDomain'), '.zslogin.net/oauth2/v1/token')]",
        "effectiveTokenUrl": "[if(variables('isOneAPI'), variables('constructedTokenUrl'), parameters('Legacy_TokenUrl'))]",
        "effectiveClientId": "[if(variables('isOneAPI'), parameters('OneAPI_ClientId'), parameters('Legacy_ClientId'))]",
        "effectiveClientSecret": "[if(variables('isOneAPI'), parameters('OneAPI_ClientSecret'), parameters('Legacy_ClientSecret'))]",
        "oneApiBaseUrl": "https://api.zsapi.net"
    },
    "resources": [
        {
            "type": "Microsoft.Logic/workflows",
            "apiVersion": "2017-07-01",
            "name": "[parameters('PlaybookName')]",
            "location": "[resourceGroup().location]",
            "tags": {
                "auth": "Oauth2",
                "hidden-SentinelTemplateName": "Zscaler-Oauth2-Authentication",
                "hidden-SentinelTemplateVersion": "3.1"
            },
            "identity": {
                "type": "SystemAssigned"
            },
            "properties": {
                "state": "Enabled",
                "definition": {
                    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
                    "contentVersion": "1.0.0.0",
                    "parameters": {
                        "clientId": {
                            "defaultValue": "[variables('effectiveClientId')]",
                            "type": "String"
                        },
                        "clientSecret": {
                            "defaultValue": "[variables('effectiveClientSecret')]",
                            "type": "SecureString"
                        },
                        "oauthUrl": {
                            "defaultValue": "[variables('effectiveTokenUrl')]",
                            "type": "String"
                        },
                        "isOneAPI": {
                            "defaultValue": "[variables('isOneAPI')]",
                            "type": "Bool"
                        },
                        "audience": {
                            "defaultValue": "https://api.zscaler.com",
                            "type": "String"
                        },
                        "oneApiBaseUrl": {
                            "defaultValue": "[variables('oneApiBaseUrl')]",
                            "type": "String"
                        },
                        "scope": {
                            "defaultValue": "[parameters('Legacy_OAuthScope')]",
                            "type": "String"
                        },
                        "zscalerBaseUrl": {
                            "defaultValue": "[parameters('Legacy_BaseUrl')]",
                            "type": "String"
                        }
                    },
                    "triggers": {
                        "manual": {
                            "type": "Request",
                            "kind": "Http",
                            "inputs": {}
                        }
                    },
                    "actions": {
                        "Check_Auth_Mode": {
                            "runAfter": {},
                            "type": "If",
                            "expression": {
                                "and": [
                                    {
                                        "equals": [
                                            "@parameters('isOneAPI')",
                                            true
                                        ]
                                    }
                                ]
                            },
                            "actions": {
                                "HTTP_OneAPI_Token": {
                                    "runAfter": {},
                                    "type": "Http",
                                    "inputs": {
                                        "body": "grant_type=client_credentials&client_id=@{encodeUriComponent(parameters('clientId'))}&client_secret=@{encodeUriComponent(parameters('clientSecret'))}&audience=@{encodeUriComponent(parameters('audience'))}",
                                        "headers": {
                                            "Content-Type": "application/x-www-form-urlencoded"
                                        },
                                        "method": "POST",
                                        "uri": "@parameters('oauthUrl')"
                                    },
                                    "runtimeConfiguration": {
                                        "secureData": {
                                            "properties": [
                                                "inputs",
                                                "outputs"
                                            ]
                                        }
                                    }
                                }
                            },
                            "else": {
                                "actions": {
                                    "HTTP_Legacy_Token": {
                                        "runAfter": {},
                                        "type": "Http",
                                        "inputs": {
                                            "body": "grant_type=client_credentials&client_id=@{encodeUriComponent(parameters('clientId'))}&client_secret=@{encodeUriComponent(parameters('clientSecret'))}&scope=@{encodeUriComponent(parameters('scope'))}",
                                            "headers": {
                                                "Content-Type": "application/x-www-form-urlencoded"
                                            },
                                            "method": "POST",
                                            "uri": "@parameters('oauthUrl')"
                                        },
                                        "runtimeConfiguration": {
                                            "secureData": {
                                                "properties": [
                                                    "inputs",
                                                    "outputs"
                                                ]
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        "Set_Token_Response": {
                            "runAfter": {
                                "Check_Auth_Mode": [
                                    "Succeeded"
                                ]
                            },
                            "type": "Compose",
                            "inputs": "@if(parameters('isOneAPI'), body('HTTP_OneAPI_Token'), body('HTTP_Legacy_Token'))"
                        },
                        "Set_Base_URL": {
                            "runAfter": {
                                "Set_Token_Response": [
                                    "Succeeded"
                                ]
                            },
                            "type": "Compose",
                            "inputs": "@if(parameters('isOneAPI'), 'api.zsapi.net/zia/api/v1', parameters('zscalerBaseUrl'))"
                        },
                        "Build_Response_Body": {
                            "runAfter": {
                                "Set_Base_URL": [
                                    "Succeeded"
                                ]
                            },
                            "type": "Compose",
                            "inputs": "@addProperty(outputs('Set_Token_Response'), 'base_url', outputs('Set_Base_URL'))"
                        },
                        "Parse_Token_Response": {
                            "runAfter": {
                                "Build_Response_Body": [
                                    "Succeeded"
                                ]
                            },
                            "type": "ParseJson",
                            "inputs": {
                                "content": "@outputs('Build_Response_Body')",
                                "schema": {
                                    "properties": {
                                        "access_token": {
                                            "type": "string"
                                        },
                                        "base_url": {
                                            "type": "string"
                                        },
                                        "expires_in": {
                                            "type": "integer"
                                        },
                                        "ext_expires_in": {
                                            "type": "integer"
                                        },
                                        "token_type": {
                                            "type": "string"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        },
                        "Response": {
                            "runAfter": {
                                "Parse_Token_Response": [
                                    "Succeeded"
                                ]
                            },
                            "type": "Response",
                            "kind": "Http",
                            "inputs": {
                                "body": "@outputs('Build_Response_Body')",
                                "headers": {
                                    "Content-Type": "application/json"
                                },
                                "statusCode": 200
                            }
                        }
                    },
                    "outputs": {}
                },
                "parameters": {
                    "clientId": {
                        "value": "[variables('effectiveClientId')]"
                    },
                    "clientSecret": {
                        "value": "[variables('effectiveClientSecret')]"
                    },
                    "oauthUrl": {
                        "value": "[variables('effectiveTokenUrl')]"
                    },
                    "isOneAPI": {
                        "value": "[variables('isOneAPI')]"
                    },
                    "audience": {
                        "value": "https://api.zscaler.com"
                    },
                    "oneApiBaseUrl": {
                        "value": "[variables('oneApiBaseUrl')]"
                    },
                    "scope": {
                        "value": "[parameters('Legacy_OAuthScope')]"
                    },
                    "zscalerBaseUrl": {
                        "value": "[parameters('Legacy_BaseUrl')]"
                    }
                }
            }
        }
    ]
}
