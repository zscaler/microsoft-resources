{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "metadata": {
        "title": "Zscaler OAuth2 Authentication",
        "description": "This playbook obtains OAuth2 access tokens for Zscaler integrations. It supports both OneAPI (ZIdentity vanity domain) and legacy (direct token URL) authentication patterns.",
        "mainSteps": [
            "1. Determines auth mode: OneAPI (vanity domain provided) or legacy (direct token URL provided)",
            "2. Requests an access token from the appropriate OAuth2 token endpoint using client credentials",
            "3. Returns the token response to the caller"
        ],
        "prerequisites": [
            "1. Zscaler subscription with API access enabled",
            "2. OAuth2 client credentials (Client ID and Client Secret)",
            "3. For OneAPI: ZIdentity vanity domain prefix (e.g., z-41181109)",
            "4. For Legacy: Direct OAuth2 token endpoint URL and OAuth2 scope (Application ID URI appended with /.default, e.g., api://c0636925-82fa-49e1-be49-72afb0a9fd59/.default)"
        ],
        "lastUpdateTime": "2025-09-02T00:00:00.000Z",
        "entities": [],
        "tags": [
            "Utilities"
        ],
        "support": {
            "tier": "Partner"
        },
        "author": {
            "name": "Zscaler"
        },
        "source": {
            "type": "solution",
            "name": "Zscaler OneAPI"
        },
        "postDeployment": [
            "**a. Validate**",
            "Trigger the playbook and confirm a token is returned."
        ],
        "releaseNotes": [
            {
                "version": "3.0.0",
                "title": "Zscaler OAuth2 Authentication - Dual Mode (OneAPI + Legacy)",
                "notes": [
                    "Supports both OneAPI (ZIdentity vanity domain) and legacy (direct token URL) authentication",
                    "OneAPI mode: token URL auto-constructed from vanity domain, audience parameter included",
                    "Legacy mode: direct token URL used as-is with OAuth2 scope parameter",
                    "Deployer provides either ZscalerVanityDomain or OAuthTokenUrl + OAuthScope (not both)"
                ]
            },
            {
                "version": "2.0.0",
                "title": "Zscaler OAuth2 Authentication - ZIdentity",
                "notes": [
                    "Updated to use Zscaler native OAuth (ZIdentity)",
                    "Removed Azure Key Vault dependency",
                    "Simplified authentication flow"
                ]
            }
        ]
    },
    "parameters": {
        "PlaybookName": {
            "defaultValue": "Zscaler-Oauth2-Authentication",
            "type": "string",
            "minLength": 1,
            "metadata": {
                "description": "Name of the Logic App/Playbook"
            }
        },
        "OAuthClientId": {
            "type": "string",
            "minLength": 1,
            "metadata": {
                "description": "OAuth2 client ID for Zscaler API access (required for both OneAPI and Legacy modes)"
            }
        },
        "OAuthClientSecret": {
            "type": "securestring",
            "minLength": 1,
            "metadata": {
                "description": "OAuth2 client secret for Zscaler API access (required for both OneAPI and Legacy modes)"
            }
        },
        "ZscalerVanityDomain": {
            "defaultValue": "",
            "type": "string",
            "metadata": {
                "description": "[[OneAPI] ZIdentity vanity domain prefix — found in your admin URL: https://<prefix>-admin.zslogin.net (e.g., z-41181109). Leave empty if using Legacy mode."
            }
        },
        "OAuthTokenUrl": {
            "defaultValue": "",
            "type": "string",
            "metadata": {
                "description": "[[Legacy] Direct OAuth2 token endpoint URL provided by your Zscaler administrator. Leave empty if using OneAPI mode."
            }
        },
        "OAuthScope": {
            "defaultValue": "",
            "type": "string",
            "metadata": {
                "description": "[[Legacy] OAuth2 scope — use the Application ID URI from your ZIA API Web Service Application appended with /.default (e.g., api://c0636925-82fa-49e1-be49-72afb0a9fd59/.default). Leave empty if using OneAPI mode."
            }
        },
        "ZscalerBaseUrl": {
            "defaultValue": "zsapi.zscaler.net/api/v1",
            "type": "string",
            "metadata": {
                "description": "[[Legacy] Zscaler ZIA API base URL (e.g., zsapi.zscalertwo.net/api/v1). Leave as default if using OneAPI mode."
            }
        }
    },
    "variables": {
        "isOneAPI": "[not(empty(parameters('ZscalerVanityDomain')))]",
        "constructedTokenUrl": "[concat('https://', parameters('ZscalerVanityDomain'), '.zslogin.net/oauth2/v1/token')]",
        "effectiveTokenUrl": "[if(variables('isOneAPI'), variables('constructedTokenUrl'), parameters('OAuthTokenUrl'))]",
        "oneApiBaseUrl": "https://api.zsapi.net"
    },
    "resources": [
        {
            "type": "Microsoft.Logic/workflows",
            "apiVersion": "2017-07-01",
            "name": "[parameters('PlaybookName')]",
            "location": "[resourceGroup().location]",
            "tags": {
                "auth": "Oauth2",
                "hidden-SentinelTemplateName": "Zscaler-Oauth2-Authentication",
                "hidden-SentinelTemplateVersion": "3.0"
            },
            "identity": {
                "type": "SystemAssigned"
            },
            "properties": {
                "state": "Enabled",
                "definition": {
                    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
                    "contentVersion": "1.0.0.0",
                    "parameters": {
                        "clientId": {
                            "defaultValue": "[parameters('OAuthClientId')]",
                            "type": "String"
                        },
                        "clientSecret": {
                            "defaultValue": "[parameters('OAuthClientSecret')]",
                            "type": "SecureString"
                        },
                        "oauthUrl": {
                            "defaultValue": "[variables('effectiveTokenUrl')]",
                            "type": "String"
                        },
                        "isOneAPI": {
                            "defaultValue": "[variables('isOneAPI')]",
                            "type": "Bool"
                        },
                        "audience": {
                            "defaultValue": "https://api.zscaler.com",
                            "type": "String"
                        },
                        "oneApiBaseUrl": {
                            "defaultValue": "[variables('oneApiBaseUrl')]",
                            "type": "String"
                        },
                        "scope": {
                            "defaultValue": "[parameters('OAuthScope')]",
                            "type": "String"
                        },
                        "zscalerBaseUrl": {
                            "defaultValue": "[parameters('ZscalerBaseUrl')]",
                            "type": "String"
                        }
                    },
                    "triggers": {
                        "manual": {
                            "type": "Request",
                            "kind": "Http",
                            "inputs": {}
                        }
                    },
                    "actions": {
                        "Check_Auth_Mode": {
                            "runAfter": {},
                            "type": "If",
                            "expression": {
                                "and": [
                                    {
                                        "equals": [
                                            "@parameters('isOneAPI')",
                                            true
                                        ]
                                    }
                                ]
                            },
                            "actions": {
                                "HTTP_OneAPI_Token": {
                                    "runAfter": {},
                                    "type": "Http",
                                    "inputs": {
                                        "body": "grant_type=client_credentials&client_id=@{encodeUriComponent(parameters('clientId'))}&client_secret=@{encodeUriComponent(parameters('clientSecret'))}&audience=@{encodeUriComponent(parameters('audience'))}",
                                        "headers": {
                                            "Content-Type": "application/x-www-form-urlencoded"
                                        },
                                        "method": "POST",
                                        "uri": "@parameters('oauthUrl')"
                                    },
                                    "runtimeConfiguration": {
                                        "secureData": {
                                            "properties": [
                                                "inputs",
                                                "outputs"
                                            ]
                                        }
                                    }
                                }
                            },
                            "else": {
                                "actions": {
                                    "HTTP_Legacy_Token": {
                                        "runAfter": {},
                                        "type": "Http",
                                        "inputs": {
                                            "body": "grant_type=client_credentials&client_id=@{encodeUriComponent(parameters('clientId'))}&client_secret=@{encodeUriComponent(parameters('clientSecret'))}&scope=@{encodeUriComponent(parameters('scope'))}",
                                            "headers": {
                                                "Content-Type": "application/x-www-form-urlencoded"
                                            },
                                            "method": "POST",
                                            "uri": "@parameters('oauthUrl')"
                                        },
                                        "runtimeConfiguration": {
                                            "secureData": {
                                                "properties": [
                                                    "inputs",
                                                    "outputs"
                                                ]
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        "Set_Token_Response": {
                            "runAfter": {
                                "Check_Auth_Mode": [
                                    "Succeeded"
                                ]
                            },
                            "type": "Compose",
                            "inputs": "@if(parameters('isOneAPI'), body('HTTP_OneAPI_Token'), body('HTTP_Legacy_Token'))"
                        },
                        "Set_Base_URL": {
                            "runAfter": {
                                "Set_Token_Response": [
                                    "Succeeded"
                                ]
                            },
                            "type": "Compose",
                            "inputs": "@if(parameters('isOneAPI'), 'api.zsapi.net/zia/api/v1', parameters('zscalerBaseUrl'))"
                        },
                        "Build_Response_Body": {
                            "runAfter": {
                                "Set_Base_URL": [
                                    "Succeeded"
                                ]
                            },
                            "type": "Compose",
                            "inputs": "@addProperty(outputs('Set_Token_Response'), 'base_url', outputs('Set_Base_URL'))"
                        },
                        "Parse_Token_Response": {
                            "runAfter": {
                                "Build_Response_Body": [
                                    "Succeeded"
                                ]
                            },
                            "type": "ParseJson",
                            "inputs": {
                                "content": "@outputs('Build_Response_Body')",
                                "schema": {
                                    "properties": {
                                        "access_token": {
                                            "type": "string"
                                        },
                                        "base_url": {
                                            "type": "string"
                                        },
                                        "expires_in": {
                                            "type": "integer"
                                        },
                                        "ext_expires_in": {
                                            "type": "integer"
                                        },
                                        "token_type": {
                                            "type": "string"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        },
                        "Response": {
                            "runAfter": {
                                "Parse_Token_Response": [
                                    "Succeeded"
                                ]
                            },
                            "type": "Response",
                            "kind": "Http",
                            "inputs": {
                                "body": "@outputs('Build_Response_Body')",
                                "headers": {
                                    "Content-Type": "application/json"
                                },
                                "statusCode": 200
                            }
                        }
                    },
                    "outputs": {}
                },
                "parameters": {
                    "clientId": {
                        "value": "[parameters('OAuthClientId')]"
                    },
                    "clientSecret": {
                        "value": "[parameters('OAuthClientSecret')]"
                    },
                    "oauthUrl": {
                        "value": "[variables('effectiveTokenUrl')]"
                    },
                    "isOneAPI": {
                        "value": "[variables('isOneAPI')]"
                    },
                    "audience": {
                        "value": "https://api.zscaler.com"
                    },
                    "oneApiBaseUrl": {
                        "value": "[variables('oneApiBaseUrl')]"
                    },
                    "scope": {
                        "value": "[parameters('OAuthScope')]"
                    },
                    "zscalerBaseUrl": {
                        "value": "[parameters('ZscalerBaseUrl')]"
                    }
                }
            }
        }
    ]
}
