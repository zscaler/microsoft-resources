                  "durationMs": 86400000
                },
                {
                  "durationMs": 172800000
                },
                {
                  "durationMs": 259200000
                },
                {
                  "durationMs": 604800000
                },
                {
                  "durationMs": 1209600000
                },
                {
                  "durationMs": 2419200000
                },
                {
                  "durationMs": 2592000000
                },
                {
                  "durationMs": 5184000000
                },
                {
                  "durationMs": 7776000000
                }
              ],
              "allowCustom": true
            }
          },
          {
            "id": "b2c3d4e5-f6a7-4b8c-9d0e-1f2a3b4c5d6e",
            "version": "KqlParameterItem/1.0",
            "name": "Verdict",
            "type": 2,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "CommonSecurityLog\r\n| where DeviceVendor == \"Zscaler\"\r\n| where DeviceProduct == \"NSSSandboxReport\"\r\n| where DeviceAction != \"\"\r\n| summarize Count = count() by DeviceAction\r\n| project Value = DeviceAction, Label = strcat(DeviceAction, \" count: \", Count)",
            "value": [
              "value::all"
            ],
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "selectAllValue": "All"
            },
            "timeContext": {
              "durationMs": 0
            },
            "timeContextFromParameter": "TimeRange",
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces"
          },
          {
            "id": "c3d4e5f6-a7b8-4c9d-0e1f-2a3b4c5d6e7f",
            "version": "KqlParameterItem/1.0",
            "name": "FileType",
            "type": 2,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "CommonSecurityLog\r\n| where DeviceVendor == \"Zscaler\"\r\n| where DeviceProduct == \"NSSSandboxReport\"\r\n| where FileType != \"\"\r\n| summarize Count = count() by FileType\r\n| project Value = FileType, Label = strcat(FileType, \" count: \", Count)",
            "value": [
              "value::all"
            ],
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "selectAllValue": "All"
            },
            "timeContext": {
              "durationMs": 0
            },
            "timeContextFromParameter": "TimeRange",
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces"
          }
        ],
        "style": "pills",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces"
      },
      "name": "parameters - 1"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "CommonSecurityLog\r\n| where DeviceVendor == \"Zscaler\"\r\n| where DeviceProduct == \"NSSSandboxReport\"\r\n| where (DeviceAction in ({Verdict}) or '{Verdict:label}' == \"All\") and (FileType in ({FileType}) or '{FileType:label}' == \"All\")\r\n| summarize Count = count() by DeviceAction\r\n| order by Count desc",
        "size": 0,
        "title": "Verdicts",
        "timeContextFromParameter": "TimeRange",
        "exportFieldName": "DeviceAction",
        "exportParameterName": "VerdictFilter",
        "exportDefaultValue": "All",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "piechart"
      },
      "customWidth": "30",
      "name": "query - 2"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "CommonSecurityLog\r\n| where DeviceVendor == \"Zscaler\"\r\n| where DeviceProduct == \"NSSSandboxReport\"\r\n| where (DeviceAction in ({Verdict}) or '{Verdict:label}' == \"All\") and (FileType in ({FileType}) or '{FileType:label}' == \"All\")\r\n| summarize Count = count() by DeviceAction, bin(TimeGenerated, {TimeRange:grain})",
        "size": 0,
        "title": "Verdicts over time",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "barchart"
      },
      "customWidth": "70",
      "name": "query - 3"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "CommonSecurityLog\r\n| where DeviceVendor == \"Zscaler\"\r\n| where DeviceProduct == \"NSSSandboxReport\"\r\n| where Activity != \"\"\r\n| where (DeviceAction in ({Verdict}) or '{Verdict:label}' == \"All\") and (FileType in ({FileType}) or '{FileType:label}' == \"All\")\r\n| summarize Count = count() by Activity\r\n| top 10 by Count\r\n| order by Count desc",
        "size": 0,
        "title": "Top threats detected",
        "timeContextFromParameter": "TimeRange",
        "exportFieldName": "Activity",
        "exportParameterName": "ThreatFilter",
        "exportDefaultValue": "All",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "Count",
              "formatter": 8,
              "formatOptions": {
                "palette": "coldHot",
                "showIcon": true
              }
            }
          ],
          "labelSettings": [
            {
              "columnId": "Activity",
              "label": "Threat Name"
            }
          ]
        }
      },
      "customWidth": "40",
      "name": "query - 4"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "CommonSecurityLog\r\n| where DeviceVendor == \"Zscaler\"\r\n| where DeviceProduct == \"NSSSandboxReport\"\r\n| where Activity != \"\"\r\n| where (DeviceAction in ({Verdict}) or '{Verdict:label}' == \"All\") and (FileType in ({FileType}) or '{FileType:label}' == \"All\")\r\n| where Activity == '{ThreatFilter}' or '{ThreatFilter}' == \"All\"\r\n| summarize Count = count() by Activity, bin(TimeGenerated, {TimeRange:grain})",
        "size": 0,
        "title": "Threats over time",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "barchart"
      },
      "customWidth": "60",
      "name": "query - 5"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "CommonSecurityLog\r\n| where DeviceVendor == \"Zscaler\"\r\n| where DeviceProduct == \"NSSSandboxReport\"\r\n| where DeviceEventCategory != \"\"\r\n| where (DeviceAction in ({Verdict}) or '{Verdict:label}' == \"All\") and (FileType in ({FileType}) or '{FileType:label}' == \"All\")\r\n| summarize Count = count() by DeviceEventCategory\r\n| order by Count desc",
        "size": 0,
        "title": "File type categories analyzed",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "piechart"
      },
      "customWidth": "30",
      "name": "query - 6"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "CommonSecurityLog\r\n| where DeviceVendor == \"Zscaler\"\r\n| where DeviceProduct == \"NSSSandboxReport\"\r\n| where DeviceCustomString4 != \"\" and DeviceCustomString4 != \"None\"\r\n| where (DeviceAction in ({Verdict}) or '{Verdict:label}' == \"All\") and (FileType in ({FileType}) or '{FileType:label}' == \"All\")\r\n| mv-expand Tactic = split(DeviceCustomString4, \"|\")\r\n| summarize Count = count() by tostring(Tactic)\r\n| order by Count desc",
        "size": 0,
        "title": "MITRE ATT&CK Tactics",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "Count",
              "formatter": 4,
              "formatOptions": {
                "min": 0,
                "palette": "red",
                "showIcon": true
              }
            }
          ],
          "filter": true
        }
      },
      "customWidth": "35",
      "name": "query - 7"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "CommonSecurityLog\r\n| where DeviceVendor == \"Zscaler\"\r\n| where DeviceProduct == \"NSSSandboxReport\"\r\n| where DeviceCustomString5 != \"\" and DeviceCustomString5 != \"None\"\r\n| where (DeviceAction in ({Verdict}) or '{Verdict:label}' == \"All\") and (FileType in ({FileType}) or '{FileType:label}' == \"All\")\r\n| mv-expand Technique = split(DeviceCustomString5, \"|\")\r\n| where tostring(Technique) != \"None\"\r\n| summarize Count = count() by tostring(Technique)\r\n| order by Count desc",
        "size": 0,
        "title": "MITRE ATT&CK Techniques",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "Count",
              "formatter": 4,
              "formatOptions": {
                "min": 0,
                "palette": "orange",
                "showIcon": true
              }
            }
          ],
          "filter": true
        }
      },
      "customWidth": "35",
      "name": "query - 8"
    },
    {
      "type": 1,
      "content": {
        "json": "---\r\n### Sandbox analysis details"
      },
      "name": "text - 9"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "CommonSecurityLog\r\n| where DeviceVendor == \"Zscaler\"\r\n| where DeviceProduct == \"NSSSandboxReport\"\r\n| where (DeviceAction in ({Verdict}) or '{Verdict:label}' == \"All\") and (FileType in ({FileType}) or '{FileType:label}' == \"All\")\r\n| where Activity == '{ThreatFilter}' or '{ThreatFilter}' == \"All\"\r\n| project TimeGenerated, Verdict = DeviceAction, ThreatName = Activity, FileType, FileCategory = DeviceEventCategory, MD5 = FileHash, SHA256 = FlexString1, EventTime = DeviceCustomDate1\r\n| order by TimeGenerated desc",
        "size": 0,
        "title": "Recent sandbox verdicts",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "Verdict",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": "contains",
                    "thresholdValue": "Malware",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "contains",
                    "thresholdValue": "Suspicious",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "contains",
                    "thresholdValue": "Benign",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "yellow",
                    "text": "{0}{1}"
                  }
                ]
              }
            }
          ],
          "filter": true
        }
      },
      "name": "query - 10"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "CommonSecurityLog\r\n| where DeviceVendor == \"Zscaler\"\r\n| where DeviceProduct == \"NSSSandboxReport\"\r\n| where (DeviceAction in ({Verdict}) or '{Verdict:label}' == \"All\") and (FileType in ({FileType}) or '{FileType:label}' == \"All\")\r\n| summarize Verdicts = dcount(DeviceAction), LatestVerdict = arg_max(TimeGenerated, DeviceAction) by FileHash\r\n| project MD5 = FileHash, TimesAnalyzed = Verdicts, LatestVerdict = DeviceAction, LastSeen = TimeGenerated\r\n| order by TimesAnalyzed desc",
        "size": 0,
        "title": "File hashes analyzed",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "TimesAnalyzed",
              "formatter": 4,
              "formatOptions": {
                "min": 0,
                "palette": "purple",
                "showIcon": true
              }
            },
            {
              "columnMatch": "LatestVerdict",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": "contains",
                    "thresholdValue": "Malware",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "contains",
                    "thresholdValue": "Suspicious",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "contains",
                    "thresholdValue": "Benign",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "yellow",
                    "text": "{0}{1}"
                  }
                ]
              }
            }
          ],
          "filter": true
        }
      },
      "customWidth": "50",
      "name": "query - 11"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "CommonSecurityLog\r\n| where DeviceVendor == \"Zscaler\"\r\n| where DeviceProduct == \"NSSSandboxReport\"\r\n| where (DeviceAction in ({Verdict}) or '{Verdict:label}' == \"All\") and (FileType in ({FileType}) or '{FileType:label}' == \"All\")\r\n| parse AdditionalExtensions with * \"datacenter=\" datacenter \";\" *\r\n| where datacenter != \"\"\r\n| summarize Count = count() by datacenter\r\n| order by Count desc",
        "size": 0,
        "title": "Verdicts by data center",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "piechart"
      },
      "customWidth": "50",
      "name": "query - 12"
    }
  ],
