    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "ZPAAppConnectorStatus\n| summarize TotalBytesReceived = sum(TotalBytesRx), TotalBytesTransmitted = sum(TotalBytesTx) by Connector, LogDate = bin(LogTimestamp, 1d)\n| order by Connector, LogDate asc\n",
        "size": 0,
        "title": "Data Transfer Over Time",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "timechart"
      },
      "name": "query - 0"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "ZPAAppConnectorStatus\n| summarize ConnectionCount = count() by ZEN\n| order by ZEN asc",
        "size": 0,
        "title": "List of ZEN Nodes and Connection Counts",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "barchart"
      },
      "name": "query - 1"
    }
