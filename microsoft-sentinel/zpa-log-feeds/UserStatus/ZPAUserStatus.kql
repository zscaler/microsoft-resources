ZPA_CL
| extend JsonStart = indexof(Message, "{")
| extend CleanMessage = iff(JsonStart >= 0, substring(Message, JsonStart), Message)
| extend ParsedData = parse_json(CleanMessage)
| where isnotnull(ParsedData.ClientType)
| project
    EventVendor="Zscaler",
    EventProduct="Private Access",
    LogTimestamp = ParsedData.LogTimestamp,
    Customer = ParsedData.Customer,
    Username = ParsedData.Username,
    SessionID = ParsedData.SessionID,
    SessionStatus = ParsedData.SessionStatus,
    Version = ParsedData.Version,
    ZEN = ParsedData.ZEN,
    CertificateCN = ParsedData.CertificateCN,
    PrivateIP = ParsedData.PrivateIP,
    PublicIP = ParsedData.PublicIP,
    Latitude = ParsedData.Latitude,
    Longitude = ParsedData.Longitude,
    CountryCode = ParsedData.CountryCode,
    TimestampAuthentication = ParsedData.TimestampAuthentication,
    TimestampUnAuthentication = ParsedData.TimestampUnAuthentication,
    TotalBytesRx = ParsedData.TotalBytesRx,
    TotalBytesTx = ParsedData.TotalBytesTx,
    Idp = ParsedData.Idp,
    Hostname = ParsedData.Hostname,
    Platform = ParsedData.Platform,
    ClientType = ParsedData.ClientType,
    TrustedNetworks = ParsedData.TrustedNetworks,
    TrustedNetworksNames = ParsedData.TrustedNetworksNames,
    PosturesHit = ParsedData.PosturesHit,
    PosturesMiss = ParsedData.PosturesMiss,
    ZENLatitude = ParsedData.ZENLatitude,
    ZENLongitude = ParsedData.ZENLongitude,
    ZENCountryCode = ParsedData.ZENCountryCode,
    FQDNRegistered = ParsedData.FQDNRegistered,
    FQDNRegisteredError = ParsedData.FQDNRegisteredError,
    SAMLAttributes = tostring(ParsedData.SAMLAttributes),
    City = ParsedData.City,
    MicroTenantID = ParsedData.MicroTenantID,
    Message = CleanMessage