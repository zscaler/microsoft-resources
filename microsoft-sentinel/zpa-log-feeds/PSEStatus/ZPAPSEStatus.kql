// Parse a ZPA timestamp field that may arrive as epoch seconds/ms/microseconds
// (Cloud NSS DCR-ingest path) or as a strftime/ISO datetime string (VM/syslog path).
let toDt = (x: dynamic) {
    case(
        isempty(tostring(x)),         datetime(null),
        strlen(tostring(x)) == 10,    datetime(1970-01-01) + tolong(x) * 1s,           // epoch seconds (Cloud NSS LogTimestamp)
        strlen(tostring(x)) == 13,    datetime(1970-01-01) + tolong(x) * 1ms,          // epoch milliseconds
        strlen(tostring(x)) == 16,    datetime(1970-01-01) + (tolong(x) / 1000) * 1ms, // epoch microseconds (Cloud NSS Timestamp*) — divide first to avoid timespan overflow
        todatetime(x))                                                                  // VM/syslog "Wed May 27 ..." or ISO 8601
};
ZPA_CL
| extend JsonStart = indexof(Message, "{")
| extend CleanMessage = iff(JsonStart >= 0, substring(Message, JsonStart), Message)
| extend ParsedLog = parse_json(CleanMessage)
| where isnotnull(ParsedLog.ServiceEdge)
| project
    EventVendor="Zscaler",
    EventProduct="Private Access",
    LogTimestamp = toDt(ParsedLog.LogTimestamp),
    Customer = tostring(ParsedLog.Customer),
    SessionID = tostring(ParsedLog.SessionID),
    SessionType = tostring(ParsedLog.SessionType),
    SessionStatus = tostring(ParsedLog.SessionStatus),
    Version = tostring(ParsedLog.Version),
    PackageVersion = tostring(ParsedLog.PackageVersion),
    Platform = tostring(ParsedLog.Platform),
    ZEN = tostring(ParsedLog.ZEN),
    ServiceEdge = tostring(ParsedLog.ServiceEdge),
    ServiceEdgeGroup = tostring(ParsedLog.ServiceEdgeGroup),
    PrivateIP = tostring(ParsedLog.PrivateIP),
    PublicIP = tostring(ParsedLog.PublicIP),
    Latitude = todouble(ParsedLog.Latitude),
    Longitude = todouble(ParsedLog.Longitude),
    CountryCode = tostring(ParsedLog.CountryCode),
    TimestampAuthentication = toDt(ParsedLog.TimestampAuthentication),
    TimestampUnAuthentication = toDt(ParsedLog.TimestampUnAuthentication),
    CPUUtilization = toint(ParsedLog.CPUUtilization),
    MemUtilization = toint(ParsedLog.MemUtilization),
    InterfaceDefRoute = tostring(ParsedLog.InterfaceDefRoute),
    DefRouteGW = tostring(ParsedLog.DefRouteGW),
    PrimaryDNSResolver = tostring(ParsedLog.PrimaryDNSResolver),
    HostUpTime = tostring(ParsedLog.HostUpTime),
    ServiceEdgeStartTime = tostring(ParsedLog.ServiceEdgeStartTime),
    NumOfInterfaces = toint(ParsedLog.NumOfInterfaces),
    BytesRxInterface = tolong(ParsedLog.BytesRxInterface),
    PacketsRxInterface = tolong(ParsedLog.PacketsRxInterface),
    ErrorsRxInterface = tolong(ParsedLog.ErrorsRxInterface),
    DiscardsRxInterface = tolong(ParsedLog.DiscardsRxInterface),
    BytesTxInterface = tolong(ParsedLog.BytesTxInterface),
    PacketsTxInterface = tolong(ParsedLog.PacketsTxInterface),
    ErrorsTxInterface = tolong(ParsedLog.ErrorsTxInterface),
    DiscardsTxInterface = tolong(ParsedLog.DiscardsTxInterface),
    TotalBytesRx = tolong(ParsedLog.TotalBytesRx),
    TotalBytesTx = tolong(ParsedLog.TotalBytesTx),
    MicroTenantID = tostring(ParsedLog.MicroTenantID),
    Message = CleanMessage;
